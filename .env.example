# ==============================================================================
# Inventory Management System — Environment Configuration Template
# Copy this file to .env and fill in the appropriate values for your environment.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Database Connection (PostgreSQL / Supabase Transaction Pooler or Direct Connection)
# Example: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/inventory_db

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
# Client-side / Public Anon Key (safe for frontend use with Row Level Security)
SUPABASE_KEY=your-anon-public-key

# Server-Side Only Service Role Secret (NEVER expose to frontend or client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-change-in-production

# CORS Configuration (comma-separated origins allowed to access the FastAPI backend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Server Configuration
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
