# ==============================================================================
# Inventory Management System — Backend Environment Configuration Template
# Copy this file to backend/.env (or root .env) and set values for your deployment.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string using asyncpg driver.
# Format: postgresql+asyncpg://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/[DB_NAME]
# Production Example (Supabase Session/Transaction Pooler):
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_db

# ------------------------------------------------------------------------------
# 2. Supabase Integration (Server-Side)
# ------------------------------------------------------------------------------
# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (read-only / RLS enabled)
SUPABASE_KEY=your-anon-public-key

# Server-side service-role secret key (BYPASSES RLS - NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars

# JWT cryptographic signature algorithm (HS256)
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
# Development: http://localhost:5173,http://localhost:3000
# Production: https://inventory.yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Server Runtime Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Inventory Management System"
ENVIRONMENT=development
API_V1_STR=/api/v1
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
