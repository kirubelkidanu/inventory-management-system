# ==============================================================================
# Inventory Management System — Frontend Environment Configuration Template
# Copy this file to frontend/.env and set values for your deployment.
#
# IMPORTANT SECURITY NOTICE (AGENTS.md Rule 6):
# ONLY variables prefixed with VITE_ are bundled into browser client code.
# NEVER place service-role keys, database passwords, or private secrets here!
# ==============================================================================

# Backend REST API Base URL
# Development (with Vite dev proxy): /api/v1 (or http://localhost:8000/api/v1)
# Production: https://api.inventory.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1

# Supabase Project URL (Publicly accessible URL)
# Example: https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for client-side use with PostgreSQL RLS)
# WARNING: DO NOT put SUPABASE_SERVICE_ROLE_KEY here!
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
